{
  "compilerOptions": {
    "target": "ES2022", "useDefineForClassFields": true,
    "module": "ESNext", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true, "types": ["vite/client", "chrome"],
    "moduleResolution": "Bundler", "allowImportingTsExtensions": true,
    "resolveJsonModule": true, "isolatedModules": true, "noEmit": true,
    "strict": true, "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "browser-extension/src/**/*.ts", "tests/**/*.ts", "vite.config.ts"]
}
